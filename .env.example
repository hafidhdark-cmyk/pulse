# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=pulse-nobus-hackathon-super-secret-key-2026

# Database Configuration (Nobus Managed PostgreSQL or Docker Postgres)
# Leave blank during local laptop dev to use the built-in local JSON/in-memory fallback adapter
# Example for Nobus DB or Docker Compose:
# DATABASE_URL=postgresql://pulse:pulse_secret@db:5432/pulsedb
DATABASE_URL=

# Optional: Enable SSL for external Nobus Managed PostgreSQL if required
DB_SSL=false

# Payment Gateway Configuration (Paystack Test Mode)
# When empty, Paystack references in test mode are verified using simulated validation
PAYSTACK_SECRET_KEY=

# Frontend Origin (for CORS)
CORS_ORIGIN=*
