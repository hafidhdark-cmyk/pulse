{
  "name": "pulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse Social Fintech MVP — Monorepo (Backend + Frontend) deployed on Nobus Cloud and Vercel",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "build:all": "npm --prefix backend test && npm --prefix frontend run build",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node backend/src/server.js",
    "test": "npm --prefix backend test",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5",
    "vercel": "^67.0.0"
  },
  "keywords": [
    "pulse",
    "fintech",
    "savings",
    "p2p",
    "nobus-cloud",
    "vercel"
  ],
  "license": "MIT"
}
